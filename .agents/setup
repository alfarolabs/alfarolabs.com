#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
SECONDS=0

node_version="$(cat .node-version)"
case "$(uname -m)" in
  x86_64) arch=x64 ;;
  aarch64) arch=arm64 ;;
  *) echo "Unsupported Node architecture: $(uname -m)" >&2; exit 1 ;;
esac
node_name="node-v${node_version}-linux-${arch}"
node_home="$HOME/.local/share/$node_name"

echo "Preparing Node $node_version"
if [[ ! -x "$node_home/bin/node" ]]; then
  download="$(mktemp -d)"
  trap 'rm -rf -- "$download"' EXIT
  base_url="https://nodejs.org/dist/v${node_version}"
  curl --fail --silent --show-error --location --retry 3 --connect-timeout 15 --max-time 120 \
    "$base_url/$node_name.tar.xz" -o "$download/$node_name.tar.xz"
  curl --fail --silent --show-error --location --retry 3 --connect-timeout 15 --max-time 30 \
    "$base_url/SHASUMS256.txt" -o "$download/SHASUMS256.txt"
  (cd "$download"; grep "  $node_name.tar.xz$" SHASUMS256.txt | sha256sum --check --strict -)
  tar -xJf "$download/$node_name.tar.xz" -C "$download"
  mkdir -p "$HOME/.local/share"
  mv "$download/$node_name" "$node_home"
fi

# A stable path lets an existing login hook follow future .node-version updates.
node_link="$HOME/.local/share/alfarolabs-node"
ln -sfn "$node_home" "$node_link"
export PATH="$node_link/bin:$PATH"
[[ "$(node --version)" == "v$node_version" ]]

# Agent processes and supervised services start in separate login shells.
profile_marker="# Alfaro Labs orb Node toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  {
    printf '\n%s\n' "$profile_marker"
    printf 'case "$PWD/" in\n  %q/*)\n' "$repo_root"
    printf '    case ":$PATH:" in\n      *:%q/bin:*) ;;\n' "$node_link"
    printf '      *) export PATH=%q/bin:"$PATH" ;;\n' "$node_link"
    printf '    esac\n    ;;\nesac\n'
  } >> "$HOME/.bash_profile"
fi
echo "Node $(node --version), npm $(npm --version) ready (${SECONDS}s)"

echo "Installing locked npm dependencies"
install_start=$SECONDS
npm ci --prefer-offline --no-audit --no-fund
echo "Dependencies ready ($((SECONDS - install_start))s); setup finished (${SECONDS}s)"
