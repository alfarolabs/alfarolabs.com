#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
node_link="$HOME/.local/share/alfarolabs-node"
profile="$HOME/.bash_profile"
profile_marker="# Alfaro Labs orb Node toolchain"
updated="$(mktemp)"
trap 'rm -f -- "$updated"' EXIT

# Amp can append environment loading after setup, overriding PATH. Move only our
# hook to the end on activation/resume, preserving all other profile contents.
if [[ -f "$profile" ]]; then
  awk -v marker="$profile_marker" '
    $0 == marker { hook = 1 }
    hook { if ($0 == "esac") hook = 0; next }
    { print }
  ' "$profile" > "$updated"
fi
{
  printf '%s\n' "$profile_marker"
  printf 'case "$PWD/" in\n  %q/*)\n' "$repo_root"
  printf '    case "$PATH" in\n      %q/bin|%q/bin:*) ;;\n' "$node_link" "$node_link"
  printf '      *) export PATH=%q/bin:"$PATH" ;;\n' "$node_link"
  printf '    esac\n    ;;\nesac\n'
} >> "$updated"

if ! cmp -s "$updated" "$profile"; then
  cat "$updated" > "$profile"
fi
