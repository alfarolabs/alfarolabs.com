{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "account_id": "e0f064ffcf4f6f2353017d06f2b33169",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
